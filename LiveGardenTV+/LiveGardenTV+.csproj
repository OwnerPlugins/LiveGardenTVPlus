<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <RootNamespace>LiveGardenTVPlus</RootNamespace>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <ApplicationIcon>Themes\logo-garden.ico</ApplicationIcon>
        <Copyright>@Lululla 2026</Copyright>
        <!-- <StartupObject>LiveGardenTVPlus.App</StartupObject> -->
        <StartupObject>LiveGardenTVPlus.Program</StartupObject>
        <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
        <GenerateDocumentationFile>True</GenerateDocumentationFile>
        <Title>LiveGardenTVPlus</Title>
        <AssemblyVersion>2.8</AssemblyVersion>
        <FileVersion>2.8</FileVersion>
        <RepositoryUrl>https://github.com/OwnerPlugins/LiveGardenTVPlus</RepositoryUrl>
        <NeutralLanguage>en</NeutralLanguage>
        <IncludeSymbols>False</IncludeSymbols>
        <PackageReadmeFile>README_VS.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
        <Platforms>AnyCPU</Platforms>
        <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <PublishSingleFile>true</PublishSingleFile>
        <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
        <PublishTrimmed>false</PublishTrimmed>
        <PublishReadyToRun>false</PublishReadyToRun>
        <SelfContained>true</SelfContained>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    </PropertyGroup>
    <!-- Package References (NuGet) -->
    <ItemGroup>
        <PackageReference Include="GTranslate" Version="2.3.1" />
        <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
        <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="XamlAnimatedGif" Version="2.3.2" />
        <PackageReference Include="XmlTvSharp" Version="1.1.2" />
    </ItemGroup>
    <!-- Content files to copy to output directory -->
    <ItemGroup>
        <!-- Languages -->
        <Content Include="Languages\**\*.lng">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <!-- PlayerHost -->
        <Content Include="PlayerHost\**\*.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <!-- Themes: XAML files (themes) -->
        <Content Include="Themes\*.xaml">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <!-- Themes: logo and avatar (copy as content, not resource) -->
        <Content Include="Themes\logo-garden.png">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="Themes\avatar.gif">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="Themes\folder.png">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <!-- Telnet commands JSON -->
        <Content Include="telnet_commands.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <!-- Icon (already used as ApplicationIcon, but also copy for runtime) -->
        <Content Include="Themes\logo-garden.ico">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
    <!-- Resource files (embedded in assembly, not copied separately) -->
    <ItemGroup>
        <Resource Include="Views\avatar.gif" />
        <Resource Include="Views\logo-garden.png" />
        <Resource Include="Themes\avatar.gif" />
        <Resource Include="Themes\folder.png" />
        <Resource Include="Themes\logo-garden.png" />
    </ItemGroup>
    <!-- License and Readme (for NuGet packaging) -->
    <ItemGroup>
        <None Update="LICENSE">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
        <None Update="README_VS.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>
    <!-- Exclude duplicate Resource entries (keep only one copy) -->
    <!--
    <ItemGroup>
        <Resource Remove="Themes\avatar.gif"/>
        <Resource Remove="Themes\folder.png"/>
        <Resource Remove="Themes\logo-garden.png"/>
    </ItemGroup> -->
</Project>