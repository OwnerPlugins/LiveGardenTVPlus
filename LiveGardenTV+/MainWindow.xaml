<Window x:Class="LiveGardenTVPlus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:material="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
        Title="TVGarden+" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop">

    <Window.Resources>
        <Style TargetType="TreeViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="3"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ToolBar x:Name="MainToolBar" Grid.Row="0">
            <Button x:Name="LoadPlaylistBtn" Click="LoadPlaylistBtn_Click"
                    ToolTip="Load M3U file from your computer">
                <StackPanel Orientation="Horizontal">
                    <material:PackIcon Kind="Folder" Width="18" Height="18" Margin="0,0,5,0"/>
                    <TextBlock x:Name="LoadPlaylistBtnText"/>
                </StackPanel>
            </Button>
            <Button x:Name="LoadOnlineBtn" Click="LoadOnlineBtn_Click"
                    ToolTip="Load M3U playlist from a web URL">
                <StackPanel Orientation="Horizontal">
                    <material:PackIcon Kind="CloudDownload" Width="18" Height="18" Margin="0,0,5,0"/>
                    <TextBlock x:Name="LoadOnlineBtnText"/>
                </StackPanel>
            </Button>
            <Button x:Name="ToggleSidebarBtn" Click="ToggleSidebarBtn_Click"
                    ToolTip="Show or hide the channel list">
                <StackPanel Orientation="Horizontal">
                    <material:PackIcon x:Name="ToggleIcon" Kind="ArrowCollapseLeft" Width="18" Height="18" Margin="0,0,5,0"/>
                    <TextBlock x:Name="ToggleText"/>
                </StackPanel>
            </Button>
            <Button x:Name="SettingsBtn" Click="SettingsBtn_Click"
                    ToolTip="Open settings window (language, buffer, online playlist)">
                <StackPanel Orientation="Horizontal">
                    <material:PackIcon Kind="Settings" Width="18" Height="18" Margin="0,0,5,0"/>
                    <TextBlock x:Name="SettingsBtnText"/>
                </StackPanel>
            </Button>
            <Button x:Name="ThemePickerBtn" Click="ThemePickerBtn_Click"
                    ToolTip="Change color theme">
                <StackPanel Orientation="Horizontal">
                    <material:PackIcon Kind="Palette" Width="18" Height="18" Margin="0,0,5,0"/>
                    <TextBlock x:Name="ThemePickerBtnText"/>
                </StackPanel>
            </Button>
            <Button x:Name="HelpBtn" Click="HelpBtn_Click"
                    ToolTip="Show help information">
                <StackPanel Orientation="Horizontal">
                    <material:PackIcon Kind="HelpCircle" Width="18" Height="18" Margin="0,0,5,0"/>
                    <TextBlock x:Name="HelpBtnText"/>
                </StackPanel>
            </Button>
            <Separator/>
            <CheckBox x:Name="ShowFavoritesOnlyCheckBox" Click="ShowFavoritesOnly_Click"
                      ToolTip="Show only channels marked as favorites"/>
            <Separator/>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="SearchBox" Width="170" 
                         GotFocus="SearchBox_GotFocus"
                         TextChanged="SearchBox_TextChanged"
                         LostFocus="SearchBox_LostFocus"
                         ToolTip="Search channels by name"/>
                <Button x:Name="ClearSearchBtn" Width="22" Height="22" Margin="2,0,0,0" 
                        Click="ClearSearchBtn_Click" Visibility="Collapsed"
                        ToolTip="Clear search text">
                    <material:PackIcon Kind="Close" Width="14" Height="14"/>
                </Button>
                <Separator/>
            </StackPanel>
            <TextBlock x:Name="CreditsTextBlock" Text=" | by Lululla | 2026 | CORVOBOYS.ORG" Margin="8,0" VerticalAlignment="Center" 
                       Foreground="{DynamicResource ForegroundBrush}" FontSize="11"
                       Cursor="Hand" MouseLeftButtonUp="CreditsTextBlock_MouseLeftButtonUp"
                       ToolTip="Open corvoboys.org forum in browser"/>
        </ToolBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ChannelColumn" Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TreeView x:Name="ChannelTreeView" Grid.Column="0" 
                      Background="{DynamicResource ControlBackgroundBrush}"
                      Foreground="{DynamicResource ForegroundBrush}"
                      SelectedItemChanged="ChannelTreeView_SelectedItemChanged">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Channels}">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GroupName}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding GroupName}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <material:PackIcon Kind="Folder" Width="18" Height="18" Margin="0,0,5,0" Foreground="#FF88CCFF"/>
                            <TextBlock Text="{Binding GroupName}" FontWeight="Bold" Foreground="#FF88CCFF"/>
                        </StackPanel>
                        <HierarchicalDataTemplate.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="ItemBorder" Margin="0,1" Background="Transparent" CornerRadius="3">
                                    <StackPanel Orientation="Horizontal">
                                        <material:PackIcon x:Name="ItemIcon" Kind="Television" Width="18" Height="18" Margin="0,0,5,0" Foreground="#FF88CCFF"/>
                                        <TextBlock x:Name="ItemText" Text="{Binding Name}" ToolTip="{Binding Url}" Foreground="{DynamicResource ForegroundBrush}"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Name}" Value="← Back to all groups">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#FF555555"/>
                                        <Setter TargetName="ItemBorder" Property="Padding" Value="5,2"/>
                                        <Setter TargetName="ItemBorder" Property="Cursor" Value="Hand"/>
                                        <Setter TargetName="ItemIcon" Property="Kind" Value="ArrowLeft"/>
                                        <Setter TargetName="ItemText" Property="FontWeight" Value="Bold"/>
                                        <Setter TargetName="ItemText" Property="Foreground" Value="#FF88CCFF"/>
                                        <Setter TargetName="ItemText" Property="FontSize" Value="14"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </HierarchicalDataTemplate.ItemTemplate>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
            <wv2:WebView2 x:Name="WebPlayer" Grid.Column="1" />
        </Grid>

        <StatusBar x:Name="MainStatusBar" Grid.Row="2">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="True"/>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <StatusBarItem>
                <StackPanel Orientation="Horizontal" Margin="5,0">
                    <Button x:Name="SpeedSlowerBtn" Width="33" Height="24" Click="SpeedSlowerBtn_Click"
                            ToolTip="Half speed (0.5x)">
                        <material:PackIcon Kind="SpeedometerSlow" Width="16" Height="16"/>
                    </Button>
                    <Button x:Name="SpeedNormalBtn" Width="33" Height="24" Click="SpeedNormalBtn_Click"
                            ToolTip="Normal speed (1x)">
                        <material:PackIcon Kind="SpeedometerMedium" Width="16" Height="16"/>
                    </Button>
                    <Button x:Name="SpeedFasterBtn" Width="33" Height="24" Click="SpeedFasterBtn_Click"
                            ToolTip="Double speed (2x)">
                        <material:PackIcon Kind="Speedometer" Width="16" Height="16"/>
                    </Button>
                </StackPanel>
            </StatusBarItem>

            <StatusBarItem>
                <StackPanel Orientation="Horizontal" Margin="10,0">
                    <TextBlock x:Name="BufferLabel" Margin="0,0,5,0" VerticalAlignment="Center" ToolTip="HLS buffer length in seconds"/>
                    <Slider x:Name="BufferSlider" Width="80" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="BufferSlider_ValueChanged"
                            ToolTip="Adjust buffer size (1-10 seconds)"/>
                    <TextBlock x:Name="BufferValueText" Text="3s" Margin="5,0" VerticalAlignment="Center" Width="30"/>
                </StackPanel>
            </StatusBarItem>

            <StatusBarItem>
                <Button x:Name="PipBtn" Width="24" Height="24" Click="PipBtn_Click"
                        ToolTip="Picture-in-Picture mode">
                    <material:PackIcon Kind="PictureInPictureTopRight" Width="16" Height="16"/>
                </Button>
            </StatusBarItem>

            <StatusBarItem>
                <Button x:Name="FullscreenUIBtn" Width="24" Height="24" Click="FullscreenUIBtn_Click"
                        ToolTip="Fullscreen (hide UI) - press ESC to exit">
                    <material:PackIcon Kind="Fullscreen" Width="16" Height="16"/>
                </Button>
            </StatusBarItem>

            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock x:Name="StreamNameStatus" Margin="5,0" ToolTip="Currently playing channel"/>
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <Separator Style="{StaticResource {x:Static StatusBar.SeparatorStyleKey}}" Margin="2,0"/>
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock x:Name="StatusTextBlock" ToolTip="Application status"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>