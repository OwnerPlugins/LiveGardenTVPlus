<Window x:Class="LiveGardenTVPlus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:material="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
        xmlns:converters="clr-namespace:LiveGardenTVPlus.Converters"
        Title="TVGarden+ by Lululla" Height="720" Width="1350"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop">

    <Window.Resources>
        <converters:UrlToImageConverter x:Key="UrlToImageConverter"/>
        <converters:BoolToStarKindConverter x:Key="BoolToStarKindConverter"/>
        <converters:BoolToStarColorConverter x:Key="BoolToStarColorConverter"/>

        <Style TargetType="TreeViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="3"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- ToolBar -->
            <RowDefinition Height="*"/>
            <!-- Player + Channels -->
            <RowDefinition Height="Auto"/>
            <!-- StatusBar -->
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBar x:Name="MainToolBar" Grid.Row="0">
        <Button x:Name="LoadPlaylistBtn" Click="LoadPlaylistBtn_Click" ToolTip="Load playlist file (M3U/JSON) from your computer">
            <StackPanel Orientation="Horizontal">
                <material:PackIcon Kind="Folder" Width="20" Height="20" Margin="0,0,5,0"/>
                <TextBlock x:Name="LoadPlaylistBtnText"/>
            </StackPanel>
        </Button>
            <Separator Margin="0" Height="1" Background="{DynamicResource BorderBrush}" HorizontalAlignment="Stretch"/>
            <!-- Button Recent with popup -->
            <Button x:Name="RecentBtn" ToolTip="Recent playlists" Click="RecentBtn_Click">
                <StackPanel Orientation="Horizontal">
                    <material:PackIcon Kind="ClockOutline" Width="20" Height="20" Margin="0,0,5,0"/>
                    <TextBlock x:Name="RecentTextBlock" Text="Recent"/>
                    <material:PackIcon Kind="MenuDown" Width="16" Height="16" Margin="5,0,0,0"/>
                </StackPanel>
            </Button>
            <Popup x:Name="RecentPopup" Placement="Absolute" StaysOpen="False" AllowsTransparency="True">
                <Border Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4">
                    <ListBox x:Name="RecentListBox" MinWidth="200" MaxHeight="200" SelectionChanged="RecentListBox_SelectionChanged"
                             DisplayMemberPath="DisplayName" Tag="FilePath"/>
                </Border>
            </Popup>
            <Separator Margin="0" Height="1" Background="{DynamicResource BorderBrush}" HorizontalAlignment="Stretch"/>
            <Button x:Name="SavePlaylistBtn" Click="SavePlaylistBtn_Click" ToolTip="Save current playlist to a new M3U file">
                <StackPanel Orientation="Horizontal">
                    <material:PackIcon Kind="ContentSave" Width="20" Height="20" Margin="0,0,5,0"/>
                    <TextBlock x:Name="SavePlaylistBtnText"/>
                </StackPanel>
            </Button>
            <Separator Margin="0" Height="1" Background="{DynamicResource BorderBrush}" HorizontalAlignment="Stretch"/>
            <ToggleButton x:Name="ShowFavoritesOnlyToggle" 
                          Click="ShowFavoritesOnly_Click" 
                          ToolTip="Show only channels marked as favorites" 
                          Margin="5,0">
                <StackPanel Orientation="Horizontal">
                    <material:PackIcon Kind="Star" 
                                       Width="20" Height="20" 
                                       Margin="0,0,5,0"/>
                    <TextBlock x:Name="FavoritesOnlyText" Text="Favorites only"/>
                </StackPanel>
            </ToggleButton>
            <Separator Margin="0" Height="1" Background="{DynamicResource BorderBrush}" HorizontalAlignment="Stretch"/>
            <Button x:Name="ExportFavoritesBtn" Click="ExportFavoritesBtn_Click" ToolTip="Export only favorite channels to a new M3U file">
                <StackPanel Orientation="Horizontal">
                    <material:PackIcon Kind="Star" Width="20" Height="20" Margin="0,0,5,0"/>
                    <TextBlock x:Name="ExportFavoritesBtnText"/>
                </StackPanel>
            </Button>

            <Button x:Name="SendToEnigmaBtn" Click="SendToEnigmaBtn_Click" ToolTip="Send playlist to Enigma2 decoder">
                <StackPanel Orientation="Horizontal">
                    <material:PackIcon Kind="TelevisionClassic" Width="20" Height="20" Margin="0,0,5,0"/>
                    <TextBlock x:Name="SendToEnigmaText" Text="Send to Enigma2"/>
                </StackPanel>
            </Button>

            <Separator Margin="0" Height="1" Background="{DynamicResource BorderBrush}" HorizontalAlignment="Stretch"/>
            <Button x:Name="EpgBtn" Click="EpgBtn_Click" ToolTip="TV Guide (EPG)">
                <StackPanel Orientation="Horizontal">
                    <material:PackIcon Kind="TelevisionGuide" Width="20" Height="20" Margin="0,0,5,0"/>
                    <TextBlock x:Name="EpgTextBlock" Text="EPG"/>
                </StackPanel>
            </Button>
            
            <Separator Margin="0" Height="1" Background="{DynamicResource BorderBrush}" HorizontalAlignment="Stretch"/>
            <Button x:Name="EditPlaylistBtn" Click="EditPlaylistBtn_Click" ToolTip="Playlist Managment">
                <StackPanel Orientation="Horizontal">
                    <material:PackIcon Kind="PlaylistEdit" Width="20" Height="20" Margin="0,0,5,0"/>
                    <TextBlock x:Name="EditPlaylistBtnText"/>
                </StackPanel>
            </Button>
            <Separator Margin="0" Height="1" Background="{DynamicResource BorderBrush}" HorizontalAlignment="Stretch"/>
            <Button x:Name="ToolsBtn" Click="ToolsBtn_Click" ToolTip="Tools">
                <StackPanel Orientation="Horizontal">
                    <material:PackIcon Kind="DotsVertical" Width="20" Height="20" Margin="0,0,5,0"/>
                    <TextBlock x:Name="ToolsBtnText" Text="Tools"/>
                </StackPanel>
            </Button>
            <Popup x:Name="ToolsPopup" Placement="Absolute" StaysOpen="False" AllowsTransparency="True">
                <Border Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4,2" MinWidth="160">
                    <StackPanel>
                        <Button x:Name="PopupSettingsBtn" Click="PopupSettingsBtn_Click" 
                                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" 
                                BorderThickness="0" Background="Transparent" Margin="0" Padding="8,6" 
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <material:PackIcon Kind="Settings" Width="20" Height="20" Margin="0,0,8,0" Foreground="{DynamicResource ForegroundBrush}"/>
                                <TextBlock x:Name="PopupSettingsText" Text="Settings" Foreground="{DynamicResource ForegroundBrush}"/>
                            </StackPanel>
                        </Button>
                        <Separator Margin="0" Height="1" Background="{DynamicResource BorderBrush}" HorizontalAlignment="Stretch"/>
                        <Button x:Name="PopupThemeBtn" Click="PopupThemeBtn_Click" 
                                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" 
                                BorderThickness="0" Background="Transparent" Margin="0" Padding="8,6" 
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <material:PackIcon Kind="Palette" Width="20" Height="20" Margin="0,0,8,0" Foreground="{DynamicResource ForegroundBrush}"/>
                                <TextBlock x:Name="PopupThemeText" Text="Theme picker" Foreground="{DynamicResource ForegroundBrush}"/>
                            </StackPanel>
                        </Button>
                        <Separator Margin="0" Height="1" Background="{DynamicResource BorderBrush}" HorizontalAlignment="Stretch"/>
                        <Button x:Name="PopupHelpBtn" Click="PopupHelpBtn_Click" 
                                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" 
                                BorderThickness="0" Background="Transparent" Margin="0" Padding="8,6" 
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <material:PackIcon Kind="HelpCircle" Width="20" Height="20" Margin="0,0,8,0" Foreground="{DynamicResource ForegroundBrush}"/>
                                <TextBlock x:Name="PopupHelpText" Text="Help" Foreground="{DynamicResource ForegroundBrush}"/>
                            </StackPanel>
                        </Button>
                        <Separator Margin="0" Height="1" Background="{DynamicResource BorderBrush}" HorizontalAlignment="Stretch"/>
                        <Button x:Name="PopupTelnetConsoleBtn" Click="PopupTelnetConsoleBtn_Click" 
                                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" 
                                BorderThickness="0" Background="Transparent" Margin="0" Padding="8,6" 
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <material:PackIcon Kind="Console" Width="20" Height="20" Margin="0,0,8,0" Foreground="{DynamicResource ForegroundBrush}"/>
                                <TextBlock x:Name="PopupTelnetConsoleText" Text="Telnet Console" Foreground="{DynamicResource ForegroundBrush}"/>
                            </StackPanel>
                        </Button>
                        <Separator Margin="0" Height="1" Background="{DynamicResource BorderBrush}" HorizontalAlignment="Stretch"/>
                        <Button x:Name="PopupAboutBtn" Click="PopupAboutBtn_Click" 
                                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" 
                                BorderThickness="0" Background="Transparent" Margin="0" Padding="8,6" 
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <material:PackIcon Kind="Information" Width="20" Height="20" Margin="0,0,8,0" Foreground="{DynamicResource ForegroundBrush}"/>
                                <TextBlock x:Name="PopupAboutText" Text="Info on" Foreground="{DynamicResource ForegroundBrush}"/>
                            </StackPanel>
                        </Button>
                        <Separator Margin="0" Height="1" Background="{DynamicResource BorderBrush}" HorizontalAlignment="Stretch"/>
                        <Button x:Name="PopupUpdateBtn" Click="PopupUpdateBtn_Click" 
                                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" 
                                BorderThickness="0" Background="Transparent" Margin="0" Padding="8,6" 
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <material:PackIcon Kind="Update" Width="20" Height="20" Margin="0,0,8,0" Foreground="{DynamicResource ForegroundBrush}"/>
                                <TextBlock x:Name="PopupUpdateText" Text="Check for updates" Foreground="{DynamicResource ForegroundBrush}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>
            <Separator Margin="0" Height="1" Background="{DynamicResource BorderBrush}" HorizontalAlignment="Stretch"/>
            <Button x:Name="AboutBtn" Click="AboutBtn_Click" ToolTip="Info on">
                <StackPanel Orientation="Horizontal">
                    <material:PackIcon Kind="Information" Width="20" Height="20" Margin="0,0,5,0"/>
                    <TextBlock x:Name="AboutBtnText"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Separator Margin="0" Height="1" Background="{DynamicResource BorderBrush}" HorizontalAlignment="Stretch"/>

            <Button x:Name="HelpBtn" Click="HelpBtn_Click" ToolTip="Help">
                <StackPanel Orientation="Horizontal">
                    <material:PackIcon Kind="Help" Width="20" Height="20" Margin="0,0,5,0"/>
                    <TextBlock x:Name="HelpBtnText" Text="Help"/>
                </StackPanel>
            </Button>
            <Separator Margin="0" Height="1" Background="{DynamicResource BorderBrush}" HorizontalAlignment="Stretch"/>

            <Button x:Name="ToggleSidebarBtn" Click="ToggleSidebarBtn_Click" ToolTip="Show or hide the channel list">
                <StackPanel Orientation="Horizontal">
                    <material:PackIcon x:Name="ToggleIcon" Kind="ArrowCollapseLeft" Width="20" Height="20" Margin="0,0,5,0"/>
                    <TextBlock x:Name="ToggleText"/>
                </StackPanel>
            </Button>

            <Separator Margin="10" Height="1" Background="{DynamicResource BorderBrush}" HorizontalAlignment="Stretch"/>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="SearchBox" Width="170" 
                         GotFocus="SearchBox_GotFocus" 
                         TextChanged="SearchBox_TextChanged" 
                         LostFocus="SearchBox_LostFocus" 
                         ToolTip="Search channels by name"
                         VerticalAlignment="Center"/>
                <Button x:Name="ClearSearchBtn" Width="Auto" Height="Auto" 
                        Margin="4,0,0,0" 
                        Click="ClearSearchBtn_Click" 
                        ToolTip="Clear search" 
                        Background="Transparent" 
                        BorderThickness="0"
                        Cursor="Hand"
                        Visibility="Visible">
                    <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource BorderBrush}">
                        <TextBlock Text="✕" 
                                   FontSize="12" 
                                   Foreground="{DynamicResource ForegroundBrush}" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"/>
                    </Border>
                </Button>
            </StackPanel>
        </ToolBar>

        <!-- Main content: Channel list + GridSplitter + WebPlayer -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ChannelColumn" Width="320"/>
                <ColumnDefinition x:Name="SplitterColumn" Width="5"/>
                <ColumnDefinition x:Name="PlayerColumn" Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Channel TreeView with logos -->
            <TreeView x:Name="ChannelTreeView" Grid.Column="0" 
                      Background="{DynamicResource ControlBackgroundBrush}" 
                      Foreground="{DynamicResource ForegroundBrush}" 
                      SelectedItemChanged="ChannelTreeView_SelectedItemChanged"
                      VirtualizingPanel.IsVirtualizing="True" 
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel">
                <TreeView.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="CopyNameMenuItem" Header="Copy Name" Click="CopyNameMenuItem_Click"/>
                        <MenuItem x:Name="CopyUrlMenuItem" Header="Copy URL" Click="CopyUrlMenuItem_Click"/>
                        <MenuItem x:Name="MoveToGroupMenuItem" Header="Move to Group" Click="MoveToGroupMenuItem_Click"/>
                        <MenuItem x:Name="DeleteChannelMenuItem" Header="Delete" Click="DeleteChannelMenuItem_Click"/>
                        <MenuItem x:Name="ExportChannelMenuItem" Header="Export" Click="ExportChannelMenuItem_Click"/>
                    </ContextMenu>
                </TreeView.ContextMenu>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Channels}">
                        <!-- Group header (folder + name) -->
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GroupName}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding GroupName}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <material:PackIcon Kind="Folder" Width="32" Height="32" Margin="0,0,8,0" Foreground="#FF88CCFF"/>
                            <TextBlock Text="{Binding GroupName}" FontWeight="Bold" Foreground="#FF88CCFF" FontSize="16"/>
                        </StackPanel>

                        <!-- Individual channel template -->
                        <HierarchicalDataTemplate.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="ItemBorder" Margin="0,2" Background="Transparent" CornerRadius="3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Logo/Fallback -->
                                            <ColumnDefinition Width="*"/>
                                            <!-- Nome canale -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Stella -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Logo image -->
                                        <Image Grid.Column="0" Source="{Binding Logo, Converter={StaticResource UrlToImageConverter}}" 
                                               Width="32" Height="32" Margin="0,0,8,0" 
                                               VerticalAlignment="Center" />
                                        <!-- Fallback icon (shown if Logo is null) -->
                                        <material:PackIcon x:Name="ItemIcon" Grid.Column="0" Kind="Television" 
                                                           Width="32" Height="32" Margin="0,0,8,0" 
                                                           Foreground="#FF88CCFF"
                                                           Visibility="Collapsed"/>
                                        <!-- Channel name (with ellipses if too long) -->
                                        <TextBlock x:Name="ItemText" Grid.Column="1" Text="{Binding Name}" 
                                                   ToolTip="{Binding Url}" Foreground="{DynamicResource ForegroundBrush}"
                                                   FontSize="16" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button x:Name="FavoriteStar" Grid.Column="2" Width="32" Height="32" 
                                                Click="FavoriteStar_Click" Background="Transparent" 
                                                BorderThickness="0" Cursor="Hand" Margin="4,0,0,0"
                                                VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <material:PackIcon Kind="{Binding IsFavorite, Converter={StaticResource BoolToStarKindConverter}}" 
                                                               Width="20" Height="20" 
                                                               Foreground="{Binding IsFavorite, Converter={StaticResource BoolToStarColorConverter}}"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <DataTemplate.Triggers>
                                    <!-- Special line "← Back to all groups" -->
                                    <DataTrigger Binding="{Binding Name}" Value="← Back to all groups">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#FF555555"/>
                                        <Setter TargetName="ItemBorder" Property="Padding" Value="5,3"/>
                                        <Setter TargetName="ItemBorder" Property="Cursor" Value="Hand"/>
                                        <Setter TargetName="ItemIcon" Property="Kind" Value="ArrowLeft"/>
                                        <Setter TargetName="ItemIcon" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="ItemText" Property="FontWeight" Value="Bold"/>
                                        <Setter TargetName="ItemText" Property="Foreground" Value="#FF88CCFF"/>
                                        <Setter TargetName="ItemText" Property="FontSize" Value="18"/>
                                    </DataTrigger>
                                    <!-- Show fallback icon if Logo is null or empty -->
                                    <DataTrigger Binding="{Binding Logo}" Value="{x:Null}">
                                        <Setter TargetName="ItemIcon" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Logo}" Value="">
                                        <Setter TargetName="ItemIcon" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </HierarchicalDataTemplate.ItemTemplate>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <!-- GridSplitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" 
                          Background="{DynamicResource AccentBrush}" 
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          Cursor="SizeWE"/>

            <!-- WebView2 player -->
            <wv2:WebView2 x:Name="WebPlayer" Grid.Column="2"/>
        </Grid>

        <!-- Status bar -->
        <StatusBar x:Name="MainStatusBar" Grid.Row="2" Height="55" Padding="5,0">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="True"/>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <StatusBarItem>
                <TextBlock x:Name="TotalChannelsText" ToolTip="Total channels in loaded playlist" FontSize="18"/>
            </StatusBarItem>

            <StatusBarItem>
                <StackPanel Orientation="Horizontal" Margin="5,0">
                    <Button x:Name="SpeedSlowerBtn" Width="36" Height="36" Click="SpeedSlowerBtn_Click" ToolTip="Half speed (0.5x)" Background="Transparent" BorderThickness="0">
                        <material:PackIcon Kind="SpeedometerSlow" Width="28" Height="28"/>
                    </Button>
                    <Button x:Name="SpeedNormalBtn" Width="36" Height="36" Click="SpeedNormalBtn_Click" ToolTip="Normal speed (1x)" Background="Transparent" BorderThickness="0">
                        <material:PackIcon Kind="SpeedometerMedium" Width="28" Height="28"/>
                    </Button>
                    <Button x:Name="SpeedFasterBtn" Width="36" Height="36" Click="SpeedFasterBtn_Click" ToolTip="Double speed (2x)" Background="Transparent" BorderThickness="0">
                        <material:PackIcon Kind="Speedometer" Width="28" Height="28"/>
                    </Button>
                </StackPanel>
            </StatusBarItem>

            <StatusBarItem>
                <StackPanel Orientation="Horizontal" Margin="10,0">
                    <TextBlock x:Name="BufferLabel" Margin="0,0,5,0" VerticalAlignment="Center" ToolTip="HLS buffer length in seconds" FontSize="14"/>
                    <Slider x:Name="BufferSlider" Width="100" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="BufferSlider_ValueChanged" ToolTip="Adjust buffer size (1-10 seconds)"/>
                    <TextBlock x:Name="BufferValueText" Text="3s" Margin="5,0" VerticalAlignment="Center" Width="40" FontSize="14"/>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem>
                <Button x:Name="PipBtn" Width="40" Height="40" Click="PipBtn_Click" ToolTip="Picture-in-Picture mode" Background="Transparent" BorderThickness="0">
                    <material:PackIcon Kind="PictureInPictureTopRight" Width="32" Height="32"/>
                </Button>
            </StatusBarItem>
            <StatusBarItem>
                <Button x:Name="FullscreenUIBtn" Width="40" Height="40" Click="FullscreenUIBtn_Click" ToolTip="Fullscreen (hide UI) - press ESC to exit" Background="Transparent" BorderThickness="0">
                    <material:PackIcon Kind="Fullscreen" Width="32" Height="32"/>
                </Button>
            </StatusBarItem>
            <StatusBarItem>
                <Button x:Name="PauseResumeBtn" Width="36" Height="36" Click="PauseResumeBtn_Click" ToolTip="Pause/Resume live stream" Background="Transparent" BorderThickness="0">
                    <material:PackIcon x:Name="PauseIcon" Kind="Pause" Width="28" Height="28"/>
                </Button>
            </StatusBarItem>
            <StatusBarItem>
                <Button x:Name="LiveBtn" Width="50" Height="36" Click="LiveBtn_Click" ToolTip="Go back to live" Background="Transparent" BorderThickness="0">
                    <material:PackIcon Kind="Television" Width="28" Height="28"/>
                </Button>
            </StatusBarItem>
            <StatusBarItem>
                <Slider x:Name="TimeshiftSlider" Width="200" Minimum="0" Maximum="100" 
                        PreviewMouseLeftButtonUp="TimeshiftSlider_PreviewMouseLeftButtonUp"
                        IsEnabled="True" ToolTip="Drag to seek back in buffer" Visibility="Collapsed"/>
            </StatusBarItem>
            <StatusBarItem>
                <ProgressBar x:Name="LoadingProgressBar" Width="120" Height="16" IsIndeterminate="True" Visibility="Collapsed" Margin="5,0"/>
            </StatusBarItem>
            <!--
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock x:Name="StreamNameStatus" Margin="5,0" ToolTip="Currently playing channel" FontSize="14"/>
            </StatusBarItem>
            -->
            <StatusBarItem DockPanel.Dock="Right">
                <Separator Style="{StaticResource {x:Static StatusBar.SeparatorStyleKey}}" Margin="2,0"/>
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock x:Name="StatusTextBlock" ToolTip="Application status" FontSize="14"/>
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <StackPanel Orientation="Horizontal" Cursor="Hand" MouseLeftButtonUp="EpgInfoPanel_MouseLeftButtonUp">
                    <material:PackIcon x:Name="EpgIcon" Kind="TelevisionGuide" Width="16" Height="16" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="EpgInfoTextBlock" Width="550" ToolTip="Click for details" FontSize="14" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>