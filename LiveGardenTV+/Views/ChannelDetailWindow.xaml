<Window x:Class="LiveGardenTVPlus.Views.ChannelDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:LiveGardenTVPlus.Converters"
        Title="Channel Details by Lululla" Height="Auto" Width="Auto"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        SizeToContent="Height">
    <Window.Resources>
        <converters:UrlToImageConverter x:Key="UrlToImageConverter"/>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Name -->
        <TextBlock x:Name="NameLabel" Text="Name:" FontWeight="Bold" Grid.Row="0" Margin="0,5,0,0" Foreground="{DynamicResource ForegroundBrush}"/>
        <TextBox x:Name="NameBox" Grid.Row="1" Margin="0,2,0,10"
                 Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}"/>

        <!-- URL (primary) -->
        <TextBlock x:Name="UrlLabel" Text="URL (primary):" FontWeight="Bold" Grid.Row="2" Margin="0,5,0,0" Foreground="{DynamicResource ForegroundBrush}"/>
        <TextBox x:Name="UrlBox" Grid.Row="3" Margin="0,2,0,10"
                 Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}"/>

        <!-- Group -->
        <TextBlock x:Name="GroupLabel" Text="Group:" FontWeight="Bold" Grid.Row="4" Margin="0,5,0,0" Foreground="{DynamicResource ForegroundBrush}"/>
        <TextBox x:Name="GroupBox" Grid.Row="5" Margin="0,2,0,10"
                 Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}"/>

        <!-- Logo URL -->
        <TextBlock x:Name="LogoLabel" Text="Logo URL:" FontWeight="Bold" Grid.Row="6" Margin="0,5,0,0" Foreground="{DynamicResource ForegroundBrush}"/>
        <TextBox x:Name="LogoBox" Grid.Row="7" Margin="0,2,0,10" TextChanged="LogoBox_TextChanged"
                 Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}"/>

        <!-- TvgId -->
        <TextBlock x:Name="TvgIdLabel" Text="TvgId:" FontWeight="Bold" Grid.Row="8" Margin="0,5,0,0" Foreground="{DynamicResource ForegroundBrush}"/>
        <TextBox x:Name="TvgIdBox" Grid.Row="9" Margin="0,2,0,10"
                 Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}"/>

        <!-- Favorite -->
        <CheckBox x:Name="FavoriteBox" Content="Favorite" Grid.Row="10" Margin="0,5,0,5"
                  Foreground="{DynamicResource ForegroundBrush}" Background="{DynamicResource ControlBackgroundBrush}"/>

        <!-- Country -->
        <TextBlock x:Name="CountryLabel" Text="Country:" FontWeight="Bold" Grid.Row="11" Margin="0,5,0,0" Foreground="{DynamicResource ForegroundBrush}"/>
        <TextBox x:Name="CountryBox" Grid.Row="12" Margin="0,2,0,10"
                 Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}"/>

        <!-- GeoBlocked -->
        <CheckBox x:Name="GeoBlockedBox" Content="GeoBlocked" Grid.Row="13" Margin="0,5,0,5"
                  Foreground="{DynamicResource ForegroundBrush}" Background="{DynamicResource ControlBackgroundBrush}"/>

        <!-- Languages -->
        <TextBlock x:Name="LanguagesLabel" Text="Languages (comma):" FontWeight="Bold" Grid.Row="14" Margin="0,5,0,0" Foreground="{DynamicResource ForegroundBrush}"/>
        <TextBox x:Name="LanguagesBox" Grid.Row="15" Margin="0,2,0,15"
                 Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}"/>

        <!-- Logo preview -->
        <TextBlock x:Name="PreviewLabel" Text="Logo Preview:" FontWeight="Bold" Grid.Row="16" Margin="0,10,0,5" HorizontalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}"/>
        <Border Grid.Row="17" Background="{DynamicResource ControlBackgroundBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                CornerRadius="6" Padding="15,15,15,15">
            <Image x:Name="LogoPreviewImage" Source="{Binding LogoUrlPreview, FallbackValue=''}" 
                   Width="220" Height="220" 
                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>

        <!-- Navigation buttons and counter -->
        <StackPanel Grid.Row="18" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,10,0,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="PrevBtn" Content="◀ Previous" Width="100" Height="32" Margin="0,0,10,0" 
                        Click="PrevBtn_Click"
                        Background="{DynamicResource ControlBackgroundBrush}"
                        Foreground="{DynamicResource ForegroundBrush}"/>
                <Button x:Name="NextBtn" Content="Next ▶" Width="100" Height="32" Margin="0,0,10,0" 
                        Click="NextBtn_Click"
                        Background="{DynamicResource ControlBackgroundBrush}"
                        Foreground="{DynamicResource ForegroundBrush}"/>
                <Button x:Name="SaveBtn" Content="Save" Click="SaveBtn_Click" Width="100" Height="32" Margin="0,0,10,0"
                        Background="{DynamicResource AccentBrush}" Foreground="White"/>
                <Button x:Name="CancelBtn" Content="Cancel" Click="CancelBtn_Click" Width="100" Height="32"
                        Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}"/>
            </StackPanel>
            <TextBlock Text="{Binding CurrentIndexInfo}" Margin="0,10,0,0" 
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource ForegroundBrush}"/>
        </StackPanel>
    </Grid>
</Window>
