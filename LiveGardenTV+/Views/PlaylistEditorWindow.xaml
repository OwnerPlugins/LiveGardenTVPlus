<Window x:Class="LiveGardenTVPlus.Views.PlaylistEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Playlist Editor" Height="700" Width="950"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar for groups and URL check -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="AddGroupBtn" Content="Add Group" Width="100" Margin="0,0,10,0" Click="AddGroupBtn_Click"/>
            <Button x:Name="RenameGroupBtn" Content="Rename Group" Width="110" Margin="0,0,10,0" Click="RenameGroupBtn_Click"/>
            <Button x:Name="DeleteGroupBtn" Content="Delete Group" Width="100" Margin="0,0,10,0" Click="DeleteGroupBtn_Click"/>
            <Button x:Name="CheckUrlsBtn" Content="Check URLs" Width="100" Margin="0,0,10,0" Click="CheckUrlsBtn_Click"/>
            <Button x:Name="ExportFailedBtn" Content="Export Failed" Width="100" Margin="0,0,10,0" Click="ExportFailedBtn_Click"/>
            <Button x:Name="ExportSuccessBtn" Content="Export Working" Width="100" Margin="0,0,10,0" Click="ExportSuccessBtn_Click"/>
        </StackPanel>

        <!-- DataGrid with editable columns and status -->
        <DataGrid x:Name="ChannelsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow" RowHeight="32">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="4*"/>
                <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="2*"/>
                <DataGridTextColumn Header="Logo" Binding="{Binding Logo}" Width="2*"/>
                <DataGridTextColumn Header="TvgId" Binding="{Binding TvgId}" Width="2*"/>
                <DataGridCheckBoxColumn Header="Favorite" Binding="{Binding IsFavorite}" Width="Auto"/>
                <DataGridTextColumn Header="Status" Binding="{Binding UrlStatus}" Width="Auto" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Bottom buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="SaveBtn" Content="Save As..." Width="80" Margin="0,0,10,0" Click="SaveBtn_Click"/>
            <Button x:Name="CloseBtn" Content="Close" Width="80" Click="CloseBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>