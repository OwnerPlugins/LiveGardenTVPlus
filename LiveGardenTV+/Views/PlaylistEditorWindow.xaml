<Window x:Class="LiveGardenTVPlus.Views.PlaylistEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:material="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf" Title="Playlist Editor by Lululla" Height="750" Width="1600" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Outer border for the entire toolbar area -->
        <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="5" Margin="0,0,0,5" Background="{DynamicResource ControlBackgroundBrush}">
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- Group 1: Playlist & Groups -->
                <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="6" Margin="5,2" Padding="8,4" Background="{DynamicResource ControlBackgroundBrush}">
                    <StackPanel>
                        <TextBlock Text="Playlist &amp; Groups" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <WrapPanel>
                            <Button x:Name="NewPlaylistBtn" Content="New" Width="140" Margin="2,0" Click="NewPlaylistBtn_Click"/>
                            <Button x:Name="AddGroupBtn" Content="Add Group" Width="140" Margin="2,0" Click="AddGroupBtn_Click"/>
                            <Button x:Name="RenameGroupBtn" Content="Rename" Width="140" Margin="2,0" Click="RenameGroupBtn_Click"/>
                            <Button x:Name="DeleteGroupBtn" Content="Delete" Width="140" Margin="2,0" Click="DeleteGroupBtn_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <!-- Group 2: URL Check & Export OK/FAIL -->
                <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="6" Margin="5,2" Padding="8,4" Background="{DynamicResource ControlBackgroundBrush}">
                    <StackPanel>
                        <TextBlock Text="URL Check" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <WrapPanel>
                            <Button x:Name="CheckUrlsBtn" Content="Check URLs" Width="140" Margin="2,0" Click="CheckUrlsBtn_Click"/>
                            <Button x:Name="SaveStatusBtn" Content="Save Status" Width="140" Margin="2,0" Click="SaveStatusBtn_Click"/>
                            <Button x:Name="ExportOkBtn" Content="Export OK" Width="140" Margin="2,0" Click="ExportOkBtn_Click"/>
                            <Button x:Name="ExportFailedBtn" Content="Export Failed" Width="140" Margin="2,0" Click="ExportFailedBtn_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <!-- Group 3: JSON -->
                <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="6" Margin="5,2" Padding="8,4" Background="{DynamicResource ControlBackgroundBrush}">
                    <StackPanel>
                        <TextBlock Text="JSON" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <WrapPanel>
                            <Button x:Name="ImportJsonBtn" Content="Import" Width="140" Margin="2,0" Click="ImportJsonBtn_Click"/>
                            <Button x:Name="ExportJsonBtn" Content="Export" Width="140" Margin="2,0" Click="ExportJsonBtn_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <!-- Group 4: Filtered Export -->
                <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="6" Margin="5,2" Padding="8,4" Background="{DynamicResource ControlBackgroundBrush}">
                    <StackPanel>
                        <TextBlock Text="Filtered Export" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <WrapPanel>
                            <Button x:Name="ExportFilteredM3uBtn" Content="M3U" Width="140" Margin="2,0" Click="ExportFilteredM3uBtn_Click"/>
                            <Button x:Name="ExportFilteredJsonBtn" Content="JSON" Width="140" Margin="2,0" Click="ExportFilteredJsonBtn_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <!-- Group 5: EPG Tools -->
                <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="6" Margin="5,2" Padding="8,4" Background="{DynamicResource ControlBackgroundBrush}">
                    <StackPanel>
                        <TextBlock Text="EPG &amp; LOGOS" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <WrapPanel>
                            <Button x:Name="EnrichWithEpgBtn" Content="Enrich" Width="140" Margin="2,0" Click="EnrichWithEpgBtn_Click"/>
                            <Button x:Name="FetchLogosBtn" Content="Fetch Logos" Width="140" Margin="2,0" Click="FetchLogosBtn_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <!-- Group 6: Actions (Save & Close) -->
                <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="6" Margin="5,2" Padding="8,4" Background="{DynamicResource ControlBackgroundBrush}">
                    <StackPanel>
                        <TextBlock Text="Actions" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <WrapPanel>
                            <Button x:Name="SaveBtn" Content="Save As..." Width="140" Margin="2,0" Click="SaveBtn_Click"/>
                            <Button x:Name="CloseBtn" Content="Close" Width="140" Margin="2,0" Click="CloseBtn_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </Border>
        <!-- Filters -->
        <!-- Filters with groups and labels above each field -->
        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="5" Margin="0,5,0,5" Background="{DynamicResource ControlBackgroundBrush}">
            <StackPanel>
                <!-- Centered FILTERS title -->
                <TextBlock x:Name="FilterLabel" Text="FILTERS" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ForegroundBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <!-- WrapPanel containing all filter groups -->
                <WrapPanel HorizontalAlignment="Center">
                    <!-- Group: Channel Info -->
                    <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="6" Margin="5,2" Padding="8,4" Background="{DynamicResource ControlBackgroundBrush}">
                        <StackPanel>
                            <TextBlock Text="Channel Info" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <WrapPanel>
                                <StackPanel Width="150" Margin="2">
                                    <TextBlock Text="Name" FontSize="11" Foreground="Gray"/>
                                    <TextBox x:Name="FilterName" material:HintAssist.Hint="e.g., Rai" ToolTip="Filter by channel name"/>
                                </StackPanel>
                                <StackPanel Width="150" Margin="2">
                                    <TextBlock Text="URL" FontSize="11" Foreground="Gray"/>
                                    <TextBox x:Name="FilterUrl" material:HintAssist.Hint="contains text"/>
                                </StackPanel>
                                <StackPanel Width="150" Margin="2">
                                    <TextBlock Text="Group" FontSize="11" Foreground="Gray"/>
                                    <TextBox x:Name="FilterGroup"/>
                                </StackPanel>
                                <StackPanel Width="150" Margin="2">
                                    <TextBlock Text="Logo URL" FontSize="11" Foreground="Gray"/>
                                    <TextBox x:Name="FilterLogo"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <!-- Group: EPG & Favorites -->
                    <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="6" Margin="5,2" Padding="8,4" Background="{DynamicResource ControlBackgroundBrush}">
                        <StackPanel>
                            <TextBlock Text="EPG &amp; Favorites" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <WrapPanel>
                                <StackPanel Width="150" Margin="2">
                                    <TextBlock Text="TvgId" FontSize="11" Foreground="Gray"/>
                                    <TextBox x:Name="FilterTvgId"/>
                                </StackPanel>
                                <StackPanel Width="150" Margin="2" VerticalAlignment="Center">
                                    <CheckBox x:Name="FilterFavorite" Content="Favorite" VerticalAlignment="Center" Margin="0,15,0,0"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <!-- Group: Geo & Country -->
                    <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="6" Margin="5,2" Padding="8,4" Background="{DynamicResource ControlBackgroundBrush}">
                        <StackPanel>
                            <TextBlock Text="Geo &amp; Country" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <WrapPanel>
                                <StackPanel Width="120" Margin="2">
                                    <TextBlock Text="Country" FontSize="11" Foreground="Gray"/>
                                    <TextBox x:Name="FilterCountry"/>
                                </StackPanel>
                                <StackPanel Width="120" Margin="2" VerticalAlignment="Center">
                                    <CheckBox x:Name="FilterGeoBlocked" Content="GeoBlocked" Margin="0,15,0,0"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <!-- Group: Advanced Identifiers -->
                    <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="6" Margin="5,2" Padding="8,4" Background="{DynamicResource ControlBackgroundBrush}">
                        <StackPanel>
                            <TextBlock Text="Advanced IDs" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <WrapPanel>
                                <StackPanel Width="150" Margin="2">
                                    <TextBlock Text="Nanoid" FontSize="11" Foreground="Gray"/>
                                    <TextBox x:Name="FilterNanoid"/>
                                </StackPanel>
                                <StackPanel Width="150" Margin="2">
                                    <TextBlock Text="Languages (comma)" FontSize="11" Foreground="Gray"/>
                                    <TextBox x:Name="FilterLanguages"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <!-- Group: URLs & Status -->
                    <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="6" Margin="5,2" Padding="8,4" Background="{DynamicResource ControlBackgroundBrush}">
                        <StackPanel>
                            <TextBlock Text="URLs &amp; Status" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <WrapPanel>
                                <StackPanel Width="150" Margin="2">
                                    <TextBlock Text="Youtube URL" FontSize="11" Foreground="Gray"/>
                                    <TextBox x:Name="FilterYoutube"/>
                                </StackPanel>
                                <StackPanel Width="150" Margin="2">
                                    <TextBlock Text="Stream URL" FontSize="11" Foreground="Gray"/>
                                    <TextBox x:Name="FilterStream"/>
                                </StackPanel>
                                <StackPanel Width="150" Margin="2">
                                    <TextBlock Text="Status" FontSize="11" Foreground="Gray"/>
                                    <TextBox x:Name="FilterStatus"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </WrapPanel>
                <!-- Action buttons for filters (Apply / Clear) -->
                <WrapPanel HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button x:Name="ApplyFilterBtn" Content="Apply" Width="150" Margin="5,0" Click="ApplyFilterBtn_Click" ToolTip="Apply current filters"/>
                    <Button x:Name="ClearFilterBtn" Content="Clear" Width="150" Margin="5,0" Click="ClearFilterBtn_Click" ToolTip="Clear all filters and show all channels"/>
                </WrapPanel>
            </StackPanel>
        </Border>
        <!-- DataGrid -->
        <DataGrid x:Name="ChannelsGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended" SelectionUnit="FullRow" RowHeight="32">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding name}" Width="2*"/>
                <DataGridTemplateColumn Header="URL (primary)" Width="3*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding stream_urls[0], FallbackValue=''}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding stream_urls[0], UpdateSourceTrigger=PropertyChanged, FallbackValue=''}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Group" Binding="{Binding group}" Width="1.5*"/>
                <DataGridTemplateColumn Header="Logo" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="..." Width="30" Margin="0,0,5,0" Click="PickLogo_Click" Tag="{Binding}" ToolTip="Choose logo from gallery"/>
                                <TextBox Text="{Binding logo_url, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}" VerticalAlignment="Center" MinWidth="150" TextWrapping="NoWrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="TvgId" Binding="{Binding tvg_id}" Width="2*"/>
                <DataGridCheckBoxColumn Header="Favorite" Binding="{Binding isFavorite}" Width="Auto"/>
                <DataGridTextColumn Header="Country" Binding="{Binding country}" Width="Auto"/>
                <DataGridCheckBoxColumn Header="GeoBlocked" Binding="{Binding isGeoBlocked}" Width="Auto"/>
                <DataGridTextColumn Header="Nanoid" Binding="{Binding nanoid}" Width="Auto"/>
                <DataGridTextColumn Header="Languages" Binding="{Binding LanguagesDisplay, Mode=OneWay}" IsReadOnly="True" Width="Auto"/>
                <DataGridTextColumn Header="Youtube URLs" Binding="{Binding YoutubeUrlsDisplay, Mode=OneWay}" IsReadOnly="True" Width="Auto"/>
                <DataGridTextColumn Header="Stream URLs" Binding="{Binding StreamUrlsDisplay, Mode=OneWay}" IsReadOnly="True" Width="Auto"/>
                <DataGridTextColumn Header="Status" Binding="{Binding UrlStatus}" Width="Auto" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
        <!-- Bottom bar -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <ProgressBar x:Name="CheckProgressBar" Height="20" Width="200" Margin="5,0" Visibility="Collapsed" IsIndeterminate="True"/>
            <TextBlock x:Name="FilteredCountText" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold" Foreground="DodgerBlue" ToolTip="Number of channels shown after filtering"/>
            <TextBlock x:Name="SelectedCountText" Margin="15,0,0,0" VerticalAlignment="Center" FontWeight="Bold" Foreground="Green" ToolTip="Number of selected channels"/>
        </StackPanel>
    </Grid>
</Window>