<Window x:Class="LiveGardenTVPlus.Views.TelnetConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Telnet Configuration by Lululla" Height="500" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <StackPanel Margin="20">
        <TextBlock x:Name="HostLabel" Text="Host:" Margin="0,0,0,5"/>
        <TextBox x:Name="HostBox" Margin="0,0,0,15" Text="192.168.1.78"/>
        <TextBlock x:Name="PortLabel" Text="Port:" Margin="0,0,0,5"/>
        <TextBox x:Name="PortBox" Margin="0,0,0,15" Text="23"/>
        <TextBlock x:Name="UserLabel" Text="Username:" Margin="0,0,0,5"/>
        <TextBox x:Name="UserBox" Margin="0,0,0,15" Text="root"/>
        <TextBlock x:Name="PassLabel" Text="Password:" Margin="0,0,0,5"/>
        <PasswordBox x:Name="PassBox" Margin="0,0,0,20"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveBtn" Content="Save" Width="80" Margin="5" Click="SaveBtn_Click"/>
            <Button x:Name="CancelBtn" Content="Cancel" Width="80" Margin="5" Click="CancelBtn_Click"/>
        </StackPanel>
    </StackPanel>
</Window>