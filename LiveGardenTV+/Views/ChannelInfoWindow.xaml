<Window x:Class="LiveGardenTVPlus.Views.ChannelInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:LiveGardenTVPlus.Converters"
        Title="Channel Info by Lululla" Height="Auto" Width="600"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    
    <Window.Resources>
        <converters:UrlToImageConverter x:Key="UrlToImageConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="INFO CHANNEL" 
                   FontSize="20" FontWeight="Bold" 
                   Width="Auto" Height="Auto"
                   HorizontalAlignment="Center" Margin="0,0,0,15"
                   Foreground="{DynamicResource AccentBrush}"/>

        <!-- Name -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Name:" FontWeight="Bold" VerticalAlignment="Center"/>
        <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1" Margin="5,0,0,10"/>

        <!-- URL -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="URL:" FontWeight="Bold" VerticalAlignment="Center"/>
        <TextBox x:Name="UrlBox" Grid.Row="2" Grid.Column="1" Margin="5,0,0,10"/>

        <!-- Group -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Group:" FontWeight="Bold" VerticalAlignment="Center"/>
        <TextBox x:Name="GroupBox" Grid.Row="3" Grid.Column="1" Margin="5,0,0,10"/>

        <!-- TvgId -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="TvgId:" FontWeight="Bold" VerticalAlignment="Center"/>
        <TextBox x:Name="TvgIdBox" Grid.Row="4" Grid.Column="1" Margin="5,0,0,10"/>

        <!-- Favorite -->
        <TextBlock Grid.Row="5" Grid.Column="0" Text="Favorite:" FontWeight="Bold" VerticalAlignment="Center"/>
        <CheckBox x:Name="FavoriteBox" Grid.Row="5" Grid.Column="1" Margin="5,0,0,10" VerticalAlignment="Center"/>

        <!-- Radio -->
        <TextBlock Grid.Row="6" Grid.Column="0" Text="Radio:" FontWeight="Bold" VerticalAlignment="Center"/>
        <CheckBox x:Name="RadioBox" Grid.Row="6" Grid.Column="1" Margin="5,0,0,10" VerticalAlignment="Center"/>

        <!-- Status -->
        <TextBlock Grid.Row="7" Grid.Column="0" Text="Status:" FontWeight="Bold" VerticalAlignment="Center"/>
        <TextBlock x:Name="StatusText" Grid.Row="7" Grid.Column="1" Margin="5,0,0,10" VerticalAlignment="Center"/>

        <!-- Logo (label + image + textbox) -->
        <TextBlock Grid.Row="8" Grid.Column="0" Text="Logo:" FontWeight="Bold" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,10">
            <Image Source="{Binding LogoUrlPreview, Converter={StaticResource UrlToImageConverter}}"
                   Width="64" Height="64" Stretch="Uniform" Margin="0,0,10,0"/>
            <TextBox x:Name="LogoBox" Text="{Binding LogoUrlPreview, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}" 
                     VerticalAlignment="Center" MinWidth="150" TextChanged="LogoBox_TextChanged"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="SaveBtn" Content="Save" Width="80" Height="30" Margin="0,0,10,0" Click="SaveBtn_Click"/>
            <Button x:Name="CloseBtn" Content="Close" Width="80" Height="30" Click="CloseBtn_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>