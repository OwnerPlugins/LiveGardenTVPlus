<Window x:Class="LiveGardenTVPlus.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:material="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
        Title="Info on TVGarden+ by Lululla" Height="Auto" Width="Auto"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        WindowStartupLocation="CenterOwner">
        <!-- ResizeMode="NoResize" -->

    <Window.Resources>
        <!-- FALLBACK BRUSHES: These are used only if the theme does not define them. -->
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- Left column: logo and avatar -->
        <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,0,20,0">
            <Image Source="pack://application:,,,/Themes/logo-garden.png" Width="96" Height="96"/>
            <Image gif:AnimationBehavior.SourceUri="pack://application:,,,/Themes/avatar.gif" Width="80" Height="80" Margin="0,10,0,0"/>
            <TextBlock x:Name="AppTitleText" Text="TVGarden+" FontSize="28" FontWeight="Bold" Margin="0,10,0,0"/>
            <TextBlock x:Name="VersionText" Text="Version 1.6" FontSize="14" Foreground="Gray" HorizontalAlignment="Center"/>
        </StackPanel>
        <!-- Right column: contents -->
        <StackPanel Grid.Column="1">
            <TextBlock x:Name="ThanksHeader" Text="Thanks to" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock x:Name="ThanksText" TextWrapping="Wrap" Margin="0,0,0,15">
                Special thanks to the CORVOBOYS &amp; LinuxSat-Support communities
                for testing and support.
            </TextBlock>
            <Separator Margin="0,10,0,10"/>
            <TextBlock x:Name="CreditsHeader" Text="Credits" FontWeight="Bold" Margin="0,0,0,5" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                <TextBlock x:Name="DevelopedByText" Text="Developed by Lululla" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/>
                <TextBlock x:Name="GitHubProfileLink" Text="Repository" Foreground="{DynamicResource AccentBrush}" Cursor="Hand" MouseLeftButtonUp="GitHubProfileLink_Click" ToolTip="Open GitHub profile"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="CorvoBoysLink" Text="CORVOBOYS.ORG" Foreground="{DynamicResource AccentBrush}" Cursor="Hand" MouseLeftButtonUp="CorvoBoysLink_Click" Margin="0,0,15,0"/>
                <TextBlock x:Name="LinuxSatLink" Text="LINUXSAT-SUPPORT.COM" Foreground="{DynamicResource AccentBrush}" Cursor="Hand" MouseLeftButtonUp="LinuxSatLink_Click"/>
            </StackPanel>
            <!-- Donation section -->
            <Separator Margin="0,10,0,10"/>
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,10">
                <TextBlock x:Name="DonationHeader" Text="Support the developer" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <WrapPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="PayPalLink" Text="PayPal" Foreground="{DynamicResource AccentBrush}" Cursor="Hand" MouseLeftButtonUp="PayPalBtn_Click" Margin="0,0,15,0"/>
                    <TextBlock x:Name="KoFiLink" Text="Ko-fi" Foreground="{DynamicResource AccentBrush}" Cursor="Hand" MouseLeftButtonUp="KoFiBtn_Click"/>
                </WrapPanel>
                <TextBlock x:Name="DonationNote" Text="(Completely voluntary – no features are blocked)" FontSize="11" Foreground="Gray" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
            <Separator Margin="0,5,0,10"/>
            <TextBlock x:Name="ChangelogHeader" Text="Changelog" FontWeight="Bold" Margin="0,0,0,5"/>
            <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="ChangelogText" TextWrapping="Wrap" Margin="0,0,0,90"/>
            </ScrollViewer>
            <Separator Margin="0,10,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SupportButton" Content="Support" Width="80" Height="30" Margin="0,0,10,0" Click="SupportButton_Click"/>
                <Button x:Name="GitHubButton" Content="Repository" Width="80" Height="30" Margin="0,0,10,0" Click="GitHubButton_Click"/>
                <Button x:Name="CloseButton" Content="Exit" Width="80" Height="30" Margin="0,0,10,0" Click="CloseButton_Click" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>