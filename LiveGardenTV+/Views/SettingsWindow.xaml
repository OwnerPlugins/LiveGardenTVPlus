<Window x:Class="LiveGardenTVPlus.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="450" Width="500"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="LanguageLabel" FontWeight="Bold" Grid.Row="0"/>
        <ComboBox x:Name="LangCombo" Grid.Row="1" Margin="0,5,0,15" SelectionChanged="LangCombo_SelectionChanged">
            <ComboBoxItem Content="Italiano" Tag="it"/>
            <ComboBoxItem Content="English" Tag="en"/>
            <ComboBoxItem Content="Español" Tag="es"/>
            <ComboBoxItem Content="Français" Tag="fr"/>
            <ComboBoxItem Content="Deutsch" Tag="de"/>
            <ComboBoxItem Content="Português" Tag="pt"/>
            <ComboBoxItem Content="Русский" Tag="ru"/>
            <ComboBoxItem Content="Nederlands" Tag="nl"/>
            <ComboBoxItem Content="Polski" Tag="pl"/>
            <ComboBoxItem Content="Türkçe" Tag="tr"/>
        </ComboBox>

        <TextBlock x:Name="BufferLabel" FontWeight="Bold" Grid.Row="2"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,5,0,15">
            <Slider x:Name="BufferSlider" Width="300" Minimum="1" Maximum="10" Value="3" TickFrequency="1" IsSnapToTickEnabled="True"/>
            <TextBlock x:Name="BufferValue" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Row 4: label -->
        <Grid Grid.Row="4" Margin="0,10,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="OnlinePlaylistLabel" FontWeight="Bold" VerticalAlignment="Center"/>
        </Grid>

        <!-- Row 5: ComboBox + Refresh button -->
        <StackPanel Grid.Row="5" Margin="0,0,0,10">
            <ComboBox x:Name="PlaylistCombo" Height="30" Margin="0,0,0,5"/>
            <Button x:Name="RefreshPlaylistsBtn" Content="Refresh from GitHub" Click="RefreshPlaylistsBtn_Click" Width="180" HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- Row 6: LOAD, SAVE, CANCEL buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="LoadPlaylistBtn" Click="LoadPlaylistBtn_Click" Width="100" Height="30" Margin="0,0,5,0" Content="LOAD"/>
            <Button x:Name="SaveBtn" Click="SaveBtn_Click" Width="100" Height="30" Margin="0,0,5,0" Content="SAVE"/>
            <Button x:Name="CancelBtn" Click="CancelBtn_Click" Width="100" Height="30" Content="CANCEL"/>
        </StackPanel>
    </Grid>
</Window>