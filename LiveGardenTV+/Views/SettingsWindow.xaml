<Window x:Class="LiveGardenTVPlus.Views.SettingsWindow" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        Title="Settings by Lululla" Height="Auto" Width="Auto"
        WindowStartupLocation="CenterOwner" 
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <Window.Resources>
        <!-- FALLBACK BRUSHES: vengono usati solo se il tema non li definisce -->
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Language -->
        <TextBlock x:Name="LanguageLabel" FontWeight="Bold" Grid.Row="0" Foreground="{DynamicResource ForegroundBrush}"/>
        <ComboBox x:Name="LangCombo" Grid.Row="1" Margin="0,5,0,15" Foreground="{DynamicResource ForegroundBrush}" Background="{DynamicResource ControlBackgroundBrush}" SelectionChanged="LangCombo_SelectionChanged">
            <ComboBoxItem Content="Italiano" Tag="it"/>
            <ComboBoxItem Content="English" Tag="en"/>
            <ComboBoxItem Content="Español" Tag="es"/>
            <ComboBoxItem Content="Français" Tag="fr"/>
            <ComboBoxItem Content="Deutsch" Tag="de"/>
            <ComboBoxItem Content="Português" Tag="pt"/>
            <ComboBoxItem Content="Русский" Tag="ru"/>
            <ComboBoxItem Content="Nederlands" Tag="nl"/>
            <ComboBoxItem Content="Polski" Tag="pl"/>
            <ComboBoxItem Content="Türkçe" Tag="tr"/>
        </ComboBox>
        <!-- Buffer -->
        <TextBlock x:Name="BufferLabel" FontWeight="Bold" Grid.Row="2" Foreground="{DynamicResource ForegroundBrush}"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,5,0,15">
            <Slider x:Name="BufferSlider" Width="300" Minimum="1" Maximum="10" Value="3" TickFrequency="1" IsSnapToTickEnabled="True"/>
            <TextBlock x:Name="BufferValue" Margin="10,0,0,0" Foreground="{DynamicResource ForegroundBrush}"/>
        </StackPanel>
        <!-- Online Playlist -->
        <TextBlock x:Name="OnlinePlaylistLabel" FontWeight="Bold" Grid.Row="4" Margin="0,10,0,5" Foreground="{DynamicResource ForegroundBrush}"/>
        <StackPanel Grid.Row="5" Margin="0,5,0,15">
            <ComboBox x:Name="PlaylistCombo" Height="30" Margin="0,0,0,5" Foreground="{DynamicResource ForegroundBrush}" Background="{DynamicResource ControlBackgroundBrush}"/>
            <Button x:Name="RefreshPlaylistsBtn" Click="RefreshPlaylistsBtn_Click" Width="180" Margin="0,0,0,5"/>
            <Button x:Name="LoadPlaylistBtn" Click="LoadPlaylistBtn_Click" Width="180"/>
        </StackPanel>
        <!-- EPG Section -->
        <TextBlock x:Name="EpgLabel" FontWeight="Bold" Grid.Row="6" Margin="0,10,0,5" Foreground="{DynamicResource ForegroundBrush}"/>
        <ComboBox x:Name="EpgCombo" Grid.Row="7" Margin="0,5,0,5" IsEditable="True" ToolTip="Select EPG source or enter custom URL" Foreground="{DynamicResource ForegroundBrush}" Background="{DynamicResource ControlBackgroundBrush}"/>
        <Button x:Name="RefreshEpgBtn" Grid.Row="8" Content="Refresh EPG List" Click="RefreshEpgBtn_Click" Width="180" Margin="0,0,0,10"/>
        <!-- EPG Threshold -->
        <TextBlock x:Name="EpgThresholdLabel" Text="EPG Matching Threshold" FontWeight="Bold" Grid.Row="9" Margin="0,10,0,0" Foreground="{DynamicResource ForegroundBrush}"/>
        <StackPanel Grid.Row="10" Orientation="Horizontal" Margin="0,5,0,10">
            <Slider x:Name="EpgThresholdSlider" Width="200" Minimum="0.5" Maximum="1.0" Value="0.75" ValueChanged="EpgThresholdSlider_ValueChanged"/>
            <TextBlock x:Name="EpgThresholdValue" Text="0.75" Margin="10,0,0,0" Foreground="{DynamicResource ForegroundBrush}"/>
        </StackPanel>
        <!-- Logos Source -->
        <TextBlock x:Name="LogosLabel" Text="Logos Source" FontWeight="Bold" Grid.Row="11" Margin="0,10,0,0" Foreground="{DynamicResource ForegroundBrush}"/>
        <ComboBox x:Name="LogosCombo" Grid.Row="12" Margin="0,5,0,5" IsEditable="True" Foreground="{DynamicResource ForegroundBrush}" Background="{DynamicResource ControlBackgroundBrush}">
            <ComboBoxItem Content="OwnerPlugins/logos (SNP)" Tag="OwnerPlugins|logos|logos/SNP" IsSelected="True"/>
            <ComboBoxItem Content="picons/picons (generic)" Tag="picons|picons|build/logos"/>
        </ComboBox>
        <!-- Logos Subfolder -->
        <TextBlock x:Name="LogosSubFolderLabel" Text="Logos Subfolder" FontWeight="Bold" Grid.Row="13" Margin="0,10,0,0" Foreground="{DynamicResource ForegroundBrush}"/>
        <ComboBox x:Name="LogosSubFolderCombo" Grid.Row="14" Margin="0,5,0,10" Foreground="{DynamicResource ForegroundBrush}" Background="{DynamicResource ControlBackgroundBrush}">
            <ComboBoxItem Content="SNP (Service Name Picons)" Tag="SNP" IsSelected="True"/>
            <ComboBoxItem Content="PROVIDER (Provider logos)" Tag="PROVIDER"/>
            <ComboBoxItem Content="ALL (all folders)" Tag="ALL"/>
        </ComboBox>
        <!-- Logos Threshold -->
        <TextBlock x:Name="LogosThresholdLabel" Text="Logos Matching Threshold" FontWeight="Bold" Grid.Row="15" Margin="0,10,0,0" Foreground="{DynamicResource ForegroundBrush}"/>
        <StackPanel Grid.Row="16" Orientation="Horizontal" Margin="0,5,0,10">
            <Slider x:Name="LogoThresholdSlider" Width="200" Minimum="0.5" Maximum="1.0" Value="0.75" ValueChanged="LogoThresholdSlider_ValueChanged"/>
            <TextBlock x:Name="LogoThresholdValue" Text="0.75" Margin="10,0,0,0" Foreground="{DynamicResource ForegroundBrush}"/>
        </StackPanel>
        <!-- Buttons -->
        <StackPanel Grid.Row="17" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="SaveBtn" Click="SaveBtn_Click" Width="100" Height="30" Margin="0,0,5,0" Content="SAVE"/>
            <Button x:Name="CancelBtn" Click="CancelBtn_Click" Width="100" Height="30" Content="CANCEL"/>
        </StackPanel>
    </Grid>
</Window>