<Window x:Class="LiveGardenTVPlus.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:material="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
        xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
        Title="Help TVGarden+ by Lululla" Height="Auto" Width="Auto"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style TargetType="Expander">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <material:PackIcon Kind="HelpCircle" Width="32" Height="32" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
            <TextBlock x:Name="TitleText" Text="LiveGardenTVPlus Help" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Playlist Loading -->
                <Expander x:Name="expPlaylistLoading" IsExpanded="True">
                    <Expander.Header>
                        <TextBlock x:Name="headerPlaylistLoading" Text="Playlist Loading" FontWeight="Bold"/>
                    </Expander.Header>
                    <StackPanel Margin="10">
                        <TextBlock x:Name="txtLoadLocal" Text="Load local M3U/JSON file – via 'Load File' button (toolbar) or 'Open File' in editor." TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtLoadOnline" Text="Load online M3U/JSON URL – 'Load Online' button (toolbar) or 'Open from URL' in editor." TextWrapping="Wrap" Margin="0,5,0,0"/>
                        <TextBlock x:Name="txtRecent" Text="Recent files – quick access to last 5 opened playlists." TextWrapping="Wrap" Margin="0,5,0,0"/>
                        <TextBlock x:Name="txtDragDrop" Text="Drag &amp; drop – drop M3U or JSON files directly onto main window." TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </Expander>

                <!-- Playlist Editor (con Playlist Comparison INSERITO QUI) -->
                <Expander x:Name="expEditor">
                    <Expander.Header>
                        <TextBlock x:Name="headerEditor" Text="Playlist Editor" FontWeight="Bold"/>
                    </Expander.Header>
                    <StackPanel Margin="10">
                        <!-- Testi esistenti -->
                        <TextBlock x:Name="txtEditorAccess" Text="Access via 'Edit Playlist' button on main toolbar." FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock x:Name="txtEditor1" Text="• Edit channel names, groups, URLs, logos, tvg-id, country, languages, favorites." TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtEditor2" Text="• Add / rename / delete groups." TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtEditor3" Text="• Check URL availability (only visible channels)." TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtEditor4" Text="• Export OK / FAIL / filtered lists as M3U or JSON." TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtEditor5" Text="• Import JSON (local or URL) with flexible field mapping (auto-detect, save mapping)." TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtEditor6" Text="• Fetch logos from remote repository (OwnerPlugins/logos)." TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtEditor7" Text="• Enrich with EPG: adds missing tvg-id using fuzzy matching." TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtEditor8" Text="• Sort any column by clicking header; use 'Reset Order' to revert to original order." TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtEditor9" Text="• Edit multiple URLs per channel (popup window)." TextWrapping="Wrap"/>

                        <!-- Playlist Comparison (INSERITO QUI) -->
                        <TextBlock x:Name="txtCompare1" Text="• Compare two playlists – load first (current playlist) and second (from file or URL)." TextWrapping="Wrap" Margin="0,10,0,0"/>
                        <TextBlock x:Name="txtCompare2" Text="• Compare by: Priority (name→group→tvg-id), Name, Group (case‑sensitive), or TvgId." TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtCompare3" Text="• Results: 'Only in First', 'Only in Second', 'In Both' – with status color coding." TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtCompare4" Text="• Export results as JSON or M3U – export missing channels or all channels." TextWrapping="Wrap"/>
                    </StackPanel>
                </Expander>

                <!-- Player Controls -->
                <Expander x:Name="expPlayerControls">
                    <Expander.Header>
                        <TextBlock x:Name="headerPlayerControls" Text="Player Control" FontWeight="Bold"/>
                    </Expander.Header>
                    <StackPanel Margin="10">
                        <TextBlock x:Name="txtPlayer1" Text="• Playback speed: 0.5x, 1x, 2x buttons." TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtPlayer2" Text="• Buffer slider: adjust HLS buffer (1‑10 seconds)." TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtPlayer3" Text="• Picture‑in‑Picture (PIP) button." TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtPlayer4" Text="• Fullscreen UI: hides sidebar and status bar (ESC to exit)." TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtPlayer5" Text="• Hide/Show channel list button." TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtPlayer6" Text="• Timeshift: pause live stream; drag slider to seek back; press 'Live' to return." TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtPlayer7" Text="• EPG info displayed in status bar for current channel." TextWrapping="Wrap"/>
                    </StackPanel>
                </Expander>

                <!-- EPG & Logos -->
                <Expander x:Name="expEpgLogos">
                    <Expander.Header>
                        <TextBlock x:Name="headerEpgLogos" Text="EPG &amp; Logos" FontWeight="Bold"/>
                    </Expander.Header>
                    <StackPanel Margin="10">
                        <TextBlock x:Name="txtEpg1" Text="EPG Guide – button on main toolbar shows full grid with program details (double‑click for info)." TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtEpg2" Text="EPG source – can be set in Settings (epgshare01 or custom URL)." TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtEpg3" Text="Logos – automatically download from GitHub repository (Settings → Logos Source)." TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtEpg4" Text="Logo Picker – in editor, click '...' to choose logo from gallery." TextWrapping="Wrap"/>
                    </StackPanel>
                </Expander>

                <!-- Settings -->
                <Expander x:Name="expSettings">
                    <Expander.Header>
                        <TextBlock x:Name="headerSettings" Text="Settings" FontWeight="Bold"/>
                    </Expander.Header>
                    <StackPanel Margin="10">
                        <TextBlock x:Name="txtSettings1" Text="Language – change UI language dynamically (translations in Languages folder)." TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtSettings2" Text="Buffer size – adjust HLS buffer seconds." TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtSettings3" Text="Online playlist – select from GitHub repository (auto‑refresh)." TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtSettings4" Text="EPG source – choose XMLTV file or enter custom URL." TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtSettings5" Text="Logos repository – choose owner/repo/path (default OwnerPlugins/logos)." TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtSettings6" Text="Matching thresholds – set fuzzy match sensitivity for EPG and logos." TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtSettings7" Text="Save – persists all settings without reloading current playlist." TextWrapping="Wrap"/>
                    </StackPanel>
                </Expander>

                <!-- Themes -->
                <Expander x:Name="expThemes">
                    <Expander.Header>
                        <TextBlock x:Name="headerThemes" Text="Themes" FontWeight="Bold"/>
                    </Expander.Header>
                    <StackPanel Margin="10">
                        <TextBlock x:Name="txtThemes1" Text="Theme picker – accessible via Tools menu on main toolbar." TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtThemes2" Text="16 colour themes + Light/Dark variants." TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtThemes3" Text="Selected theme is saved and applied on restart." TextWrapping="Wrap"/>
                    </StackPanel>
                </Expander>

                <!-- Updates -->
                <Expander x:Name="expUpdates">
                    <Expander.Header>
                        <TextBlock x:Name="headerUpdates" Text="Updates" FontWeight="Bold"/>
                    </Expander.Header>
                    <StackPanel Margin="10">
                        <TextBlock x:Name="txtUpdates1" Text="Automatic check on startup – or click 'Check for updates' in Tools menu." TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtUpdates2" Text="Downloads ZIP, replaces files, restarts app – settings preserved." TextWrapping="Wrap"/>
                    </StackPanel>
                </Expander>

                <!-- Credits -->
                <Expander x:Name="expCredits">
                    <Expander.Header>
                        <TextBlock x:Name="headerCredits" Text="Credits" FontWeight="Bold"/>
                    </Expander.Header>
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,0,20,0">
                            <Image Source="pack://application:,,,/Themes/logo-garden.png" Width="96" Height="96"/>
                            <Image gif:AnimationBehavior.SourceUri="pack://application:,,,/Themes/avatar.gif" Width="80" Height="80" Margin="0,10,0,0" Source="/Themes/avatar.gif"/>
                            <TextBlock Text="TVGarden+" FontSize="28" FontWeight="Bold" Margin="0,10,0,0"/>
                            <TextBlock x:Name="VersionText" Text="Version" FontSize="14" Foreground="Gray" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="txtCreditsDev" Text="Developer: Lululla" FontWeight="Bold"/>
                            <TextBlock x:Name="txtCreditsPlaylist" Text="Playlist repository: OwnerPlugins/TivuStreamList (Italian &amp; international streams)" TextWrapping="Wrap"/>
                            <TextBlock x:Name="txtCreditsHls" Text="HLS playback: hls.js (MIT license)" TextWrapping="Wrap"/>
                            <TextBlock x:Name="txtCreditsUI" Text="UI: MaterialDesignThemes.Wpf" TextWrapping="Wrap"/>
                            <TextBlock x:Name="txtCreditsWebView" Text="WebView2: Microsoft Edge WebView2" TextWrapping="Wrap"/>
                            <TextBlock x:Name="txtCreditsCommunity" Text="Community &amp; testing: CorvoBoys (corvoboys.org) &amp; LinuxSat-Support.com" TextWrapping="Wrap"/>
                            <TextBlock x:Name="txtCreditsGitHub" Text="Github: https://github.com/OwnerPlugins/LiveGardenTVPlus" TextWrapping="Wrap" Cursor="Hand" Foreground="{DynamicResource AccentBrush}" MouseLeftButtonUp="txtCreditsGitHub_MouseLeftButtonUp"/>
                        </StackPanel>
                    </Grid>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="SupportBtn" Content="Support" Width="80" Height="30" Margin="0,0,10,0" Click="SupportBtn_Click"/>
            <Button x:Name="GitHubHelpBtn" Content="Repository" Width="80" Height="30" Click="GitHubBtn_Click" Margin="0,0,10,0"/>
            <Button x:Name="CloseBtn" Content="Exit" Width="80" Height="30" Margin="0,0,10,0" IsCancel="True" Click="CloseBtn_Click"/>
        </StackPanel>

    </Grid>
</Window>