<Window x:Class="LiveGardenTVPlus.Views.TelnetConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Telnet Commander" Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Colonna sinistra -->
        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Connection -->
            <GroupBox x:Name="grpConnection" Header="Connection" Grid.Row="0" Margin="0,0,5,5"
                      Background="{DynamicResource ControlBackgroundBrush}"
                      BorderBrush="{DynamicResource BorderBrush}">
                <StackPanel Margin="5">
                    <TextBlock Text="Host:" Foreground="{DynamicResource ForegroundBrush}"/>
                    <TextBox x:Name="HostBox" Margin="0,0,0,10" Text="192.168.1.78"
                             Background="{DynamicResource ControlBackgroundBrush}"
                             Foreground="{DynamicResource ForegroundBrush}"/>
                    <TextBlock Text="Port:" Foreground="{DynamicResource ForegroundBrush}"/>
                    <TextBox x:Name="PortBox" Margin="0,0,0,10" Text="23"
                             Background="{DynamicResource ControlBackgroundBrush}"
                             Foreground="{DynamicResource ForegroundBrush}"/>
                    <TextBlock Text="Username:" Foreground="{DynamicResource ForegroundBrush}"/>
                    <TextBox x:Name="UserBox" Margin="0,0,0,10" Text="root"
                             Background="{DynamicResource ControlBackgroundBrush}"
                             Foreground="{DynamicResource ForegroundBrush}"/>
                    <TextBlock Text="Password:" Foreground="{DynamicResource ForegroundBrush}"/>
                    <PasswordBox x:Name="PassBox" Margin="0,0,0,10"
                                 Background="{DynamicResource ControlBackgroundBrush}"
                                 Foreground="{DynamicResource ForegroundBrush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                        <Button x:Name="ConnectBtn" Content="Connect" Width="80" Margin="0,0,5,0" Click="ConnectBtn_Click"/>
                        <Button x:Name="DisconnectBtn" Content="Disconnect" Width="80" IsEnabled="False" Click="DisconnectBtn_Click"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
            <!-- Quick Commands -->
            <GroupBox x:Name="grpCommands" Header="Quick Commands" Grid.Row="1" Margin="0,5,5,0"
                      Background="{DynamicResource ControlBackgroundBrush}"
                      BorderBrush="{DynamicResource BorderBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListBox x:Name="CommandsList" Grid.Row="0" Margin="0,0,0,5"
                             Background="{DynamicResource ControlBackgroundBrush}"
                             Foreground="{DynamicResource ForegroundBrush}"
                             SelectionChanged="CommandsList_SelectionChanged"/>
                    <WrapPanel Grid.Row="1" Margin="0,5,0,0" HorizontalAlignment="Stretch">
                        <Button x:Name="AddCmdBtn" Content="Add" Width="auto" Margin="0,0,5,5" Click="AddCmdBtn_Click"/>
                        <Button x:Name="RemoveCmdBtn" Content="Remove" Width="auto" Margin="0,0,5,5" Click="RemoveCmdBtn_Click"/>
                        <Button x:Name="EditCmdBtn" Content="Edit" Width="auto" Margin="0,0,5,5" Click="EditCmdBtn_Click"/>
                        <Button x:Name="ReloadGUIBtn" Content="Reload GUI" Width="auto" Margin="0,0,0,5" Click="ReloadGUIBtn_Click"/>
                    </WrapPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- GridSplitter -->
        <GridSplitter Grid.Row="0" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                      Background="{DynamicResource AccentBrush}" ResizeBehavior="PreviousAndNext"/>

        <!-- Colonna destra -->
        <GroupBox x:Name="grpOutput" Header="Output" Grid.Row="0" Grid.Column="2" Margin="5,0,0,0"
                  Background="{DynamicResource ControlBackgroundBrush}"
                  BorderBrush="{DynamicResource BorderBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <RichTextBox x:Name="OutputBox" Grid.Row="0" IsReadOnly="True"
                             Background="{DynamicResource ControlBackgroundBrush}"
                             Foreground="{DynamicResource ForegroundBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             VerticalScrollBarVisibility="Auto"/>
                <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,5,0,0">
                    <TextBox x:Name="InputBox" Width="300" Margin="0,0,5,0"
                             Background="{DynamicResource ControlBackgroundBrush}"
                             Foreground="{DynamicResource ForegroundBrush}"
                             KeyDown="InputBox_KeyDown"/>
                    <Button x:Name="SendBtn" Content="Send" Width="80" Click="SendBtn_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Status bar in basso -->
        <StatusBar Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0"
                   Background="{DynamicResource ControlBackgroundBrush}"
                   BorderBrush="{DynamicResource BorderBrush}">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Disconnected"
                           Foreground="{DynamicResource ForegroundBrush}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>